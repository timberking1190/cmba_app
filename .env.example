# ─────────────────────────────────────────────────────────────────────────────
# TeamLinkt integration
# ─────────────────────────────────────────────────────────────────────────────
# The schedule/standings pages read TeamLinkt's (undocumented) league JSON
# endpoints server-side and render them in our own design, with the official
# TeamLinkt iframe as an automatic fallback if those endpoints change. IDs change
# each season, so they are read from env (never hardcoded in components).

TEAMLINKT_LEAGUE_BASE=https://leagues.teamlinkt.com
TEAMLINKT_ASSOC_ID=34176
TEAMLINKT_SEASON_ID=50938
TEAMLINKT_LEAGUE_SLUG=calgaryminorbasketballassociation

# Base URL for TeamLinkt deep-links (login, score reporting, account actions).
# We never collect TeamLinkt credentials or proxy their auth.
NEXT_PUBLIC_TEAMLINKT_APP_URL=https://app.teamlinkt.com
# When false, the public schedule and standings read ONLY our own data (cutover).
# Default true keeps the TeamLinkt fallback until a season is seeded (Stage B).
FEATURE_LEGACY_TEAMLINKT=true

# ─────────────────────────────────────────────────────────────────────────────
# CMBA Connect backend (Payload CMS 3) — ALL personal data stays in Canada.
# See docs/PROVISIONING_CHECKLIST.md and docs/DATA_RESIDENCY_AND_COMPLIANCE.md.
# Never commit real secrets; set these in .env (local) and Vercel (Prod+Preview).
# ─────────────────────────────────────────────────────────────────────────────

# Core
PAYLOAD_SECRET=                       # long random string (e.g. `openssl rand -base64 32`)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database — Supabase Postgres, project region ca-central-1 (Montréal)
DATABASE_URL=                         # postgres connection string from Supabase

# File storage — Supabase Storage (S3-compatible), ca-central-1.
# TWO buckets: one PUBLIC (profile photos, page images), one PRIVATE (certificates).
S3_ENDPOINT=                          # https://<project>.supabase.co/storage/v1/s3
S3_REGION=ca-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=                     # public bucket name (images)
S3_BUCKET_PRIVATE=                    # private bucket name (certificate files)
# S3_BUCKET=                          # optional single-bucket fallback for public

# Email — AWS SES, ca-central-1 (SMTP). Keep PII out of email bodies.
SES_SMTP_HOST=email-smtp.ca-central-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
EMAIL_FROM=no-reply@cmba.ab.ca

# First super-admin bootstrap (used only by `npm run create-admin`)
CREATE_ADMIN_EMAIL=
CREATE_ADMIN_PASSWORD=
CREATE_ADMIN_NAME=CMBA Super Admin

# Cron protection (Phase 2) — Vercel Cron sends this as a Bearer/secret header.
CRON_SECRET=

# Stage B: enable team-level ICS calendar feeds (youth movement-pattern disclosure; off by default)
FEATURE_TEAM_ICS=false
# Minimum supported native app version (soft nudge via /api/v1/config)
MIN_SUPPORTED_APP_VERSION=0.0.0

# ─────────────────────────────────────────────────────────────────────────────
# Stage C — security (see docs/SECURITY.md and MODULE_SECURITY_PROMPT.md)
# ─────────────────────────────────────────────────────────────────────────────

# Content Security Policy rollout switch. Set to `true` for the FIRST preview
# deploy: the browser receives the policy as report-only (nothing is blocked) and
# violations are logged to /api/csp-report. Confirm /admin and every page render
# clean, then unset (or `false`) to ENFORCE. Default (unset) enforces.
CSP_REPORT_ONLY=

# script-src strategy. Default (unset) is the gold-standard strict-nonce policy
# ('self' + per-request nonce + strict-dynamic); the public site is dynamically
# rendered so Next stamps the nonce onto every script. Set to `true` ONLY to fall
# back to the legacy 'self' 'unsafe-inline' policy (e.g. if a static export is
# reintroduced and nonce propagation is unavailable).
CSP_COMPAT_SCRIPTS=

# Bot challenge on the public game-report form (Cloudflare Turnstile, privacy
# respecting, no profiling). Leave BOTH blank to keep it disabled (rate limiting +
# honeypot still apply). Set both to switch the CAPTCHA on with no code change.
TURNSTILE_SECRET=                     # server-side secret (siteverify)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=       # public widget site key

# ── S1 multi-factor authentication (NIST SP 800-63B-4) ──────────────────────
# AES-256-GCM key that encrypts TOTP secrets at rest. 32 bytes, base64. MUST be
# separate from PAYLOAD_SECRET. Generate: `openssl rand -base64 32`. Rotating it
# invalidates existing TOTP enrollments (users re-enroll), so treat as a managed key.
TOTP_ENC_KEY=
# WebAuthn / passkeys. RP ID is the registrable domain (no scheme/port). ORIGINS is
# a comma-separated allowlist of exact origins permitted to complete a ceremony;
# preview hosts are intentionally excluded.
WEBAUTHN_RP_ID=cmbaplatform.vercel.app
WEBAUTHN_ORIGINS=https://cmbaplatform.vercel.app
# MFA enforcement kill-switch. Leave false until the super admin has enrolled a
# factor; then set true to require MFA (force-enrollment, never a hard lockout).
MFA_ENFORCE=false
# Email one-time-passcode recovery channel. Recovery only (never satisfies admin
# MFA). Requires SES (ca-central-1) to actually deliver; keep off until provisioned.
FEATURE_EMAIL_OTP=false

# ── Observability (P1.5) ────────────────────────────────────────────────────
# Error monitoring: Sentry. OFF unless a DSN is set (builds/dev never phone home).
# Create the Sentry project in the EU region for a Canadian minors-first service,
# and record it in docs/PROCESSOR_REGISTER.md + the privacy policy. No personal data
# is sent (sendDefaultPii off + scrubEvent). SENTRY_DSN is server-side; the
# NEXT_PUBLIC_ copy is the browser DSN (usually the same project DSN).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional label for the environment shown in Sentry (defaults to VERCEL_ENV/NODE_ENV).
SENTRY_ENVIRONMENT=
# Product analytics + Web Vitals: Vercel Web Analytics + Speed Insights. Cookieless
# and aggregate; enable them in the Vercel project dashboard (no key needed). They
# are a no-op off Vercel, so no local config is required.

# ── S4 registration readiness ───────────────────────────────────────────────
# Public self-registration mode. `open` (default) keeps current self-signup (with
# server-side rate limiting + honeypot + optional Turnstile). `closed` requires an
# admin to create accounts (the invite-only effect). Set to `closed` for a
# controlled launch. A token-based self-serve invite flow is the next step.
REGISTRATION_MODE=open

# Registration rate limits, per hour. Optional; both fall back to the defaults
# below if unset or malformed. These fail CLOSED, so a family that trips one sees
# an error and concludes registration is broken. Widen them BEFORE a launch day
# rather than during one. Turnstile is the real bot defence; the global cap is a
# backstop against a catastrophic distributed event, not the primary control.
# Defaults: 20 per IP per hour, 2000 globally per hour.
# REGISTER_RATE_LIMIT_IP=20
# REGISTER_RATE_LIMIT_GLOBAL=2000
