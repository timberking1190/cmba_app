# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/

# audit tooling raw output. The committed baselines under docs/audit/ are the
# durable artefacts; these are the noisy per-run reports that produced them.
/.lighthouseci/
/.next/analyze/

# local build-prompt / spec working directory (not app code)
/cmba-backend-build/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (real secrets) — .env.example stays tracked
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
